{
  "title": "GTFSynq Spring Apps",
  "uid": "gtfsynq-spring",
  "tags": ["gtfsynq", "spring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate (per instance)",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (instance, le) (rate(http_server_requests_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{instance}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JVM memory used",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (instance, area) (jvm_memory_used_bytes)",
          "legendFormat": "{{instance}} {{area}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU usage (process / system)",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        { "expr": "process_cpu_usage", "legendFormat": "process {{instance}}" },
        { "expr": "system_cpu_usage", "legendFormat": "system {{instance}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HikariCP connections",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "active {{instance}}"
        },
        {
          "expr": "hikaricp_connections_idle",
          "legendFormat": "idle {{instance}}"
        },
        {
          "expr": "hikaricp_connections_pending",
          "legendFormat": "pending {{instance}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Log events rate",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (instance, level) (rate(logback_events_total[$__rate_interval]))",
          "legendFormat": "{{instance}} {{level}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Up",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [{ "expr": "up{job=\"gtfsynq-apps\"}" }],
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 24 }
    }
  ]
}
