{
  "title": "GTFSynq Kafka",
  "uid": "gtfsynq-kafka",
  "tags": ["gtfsynq", "kafka"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Topic current offset",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "kafka_topic_partition_current_offset{topic=\"gtfs-trip-updates\"}",
          "legendFormat": "partition {{partition}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Consumer group lag",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "kafka_consumergroup_lag",
          "legendFormat": "{{consumergroup}} {{topic}} p{{partition}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Brokers up",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [{ "expr": "kafka_brokers" }],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Spring Kafka listener / template",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "rate(spring_kafka_listener_seconds_count[$__rate_interval])",
          "legendFormat": "listener {{instance}}"
        },
        {
          "expr": "rate(spring_kafka_template_seconds_count[$__rate_interval])",
          "legendFormat": "template {{instance}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Static feed topic current offset",
      "description": "Offsets on the static feed topic. Flat means nothing new has been published; it only rises when a feed actually changed.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "kafka_topic_partition_current_offset{topic=\"gtfs-static-feeds\"}",
          "legendFormat": "partition {{partition}}",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    }
  ]
}
