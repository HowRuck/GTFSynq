{
  "title": "GTFSynq Domain",
  "uid": "gtfsynq-domain",
  "tags": [
    "gtfsynq",
    "domain"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 8,
  "editable": true,
  "refresh": "30s",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "VictoriaMetrics"
        },
        "query": "label_values(application)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "definition": "label_values(application)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Application availability",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "count({application=~\"$application\"})",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Ingest",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Invalid feed entities skipped",
      "description": "Invalid feed entities skipped per second because they have no ID or entity type.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(gtfs.ingest.skipped.invalid{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Invalid entities skipped",
      "description": "Total invalid feed entities skipped during the selected time range.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (application) (increase(gtfs.ingest.skipped.invalid{application=~\"$application\"}[$__range]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      }
    },
    {
      "id": 21,
      "type": "row",
      "title": "Static feed",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 13
      }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Static feed age since last success",
      "description": "Seconds since the stalest configured feed was last ingested successfully. Static feeds poll on a days-scale cadence, so a growing value here is the stall signal no counter can give.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "max(gtfs.static.last.success.age.seconds{application=~\"$application\"})",
          "legendFormat": "stalest feed",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Age since last success by feed",
      "description": "Seconds since each feed was last ingested successfully. Alert when a feed exceeds roughly two poll intervals.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "gtfs.static.last.success.age.seconds{application=~\"$application\"}",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Static ingestion attempts by outcome",
      "description": "Attempts per second: success (new revision stored and published), unchanged (archive already stored) and failed.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(gtfs.static.ingest{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Static feed download duration (average)",
      "description": "Time to stream a static archive off the remote server, 95th percentile. Useful for diagnosing the static-feed timeout.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum(rate(gtfs.static.download.duration_sum{application=~\"$application\"}[$__rate_interval])) / sum(rate(gtfs.static.download.duration_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "average",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      }
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Static ingestion cycles skipped",
      "description": "Scheduled cycles skipped because the previous one was still running. Non-zero means ingestion is falling behind its own schedule.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum(increase(gtfs.static.cycle.skipped{application=~\"$application\"}[$__range]))",
          "legendFormat": "skipped",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      }
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Static archive size (max in range)",
      "description": "Largest archive downloaded per feed in the current window. A sudden drop can mean a truncated or partial download.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "max by (feed) (max_over_time(gtfs.static.archive.size.max{application=~\"$application\"}[$__range]))",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      }
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Static feed cycle duration (average)",
      "description": "Wall clock time for one scheduled cycle, 95th percentile. Rising toward the poll interval is the early warning that cycle.skipped will start incrementing.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum(rate(gtfs.static.cycle.duration_sum{application=~\"$application\"}[$__rate_interval])) / sum(rate(gtfs.static.cycle.duration_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "average",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      }
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Feeds configured vs reporting",
      "description": "Sources with a usable static URL against feeds that have actually reported an attempt. A persistent gap means a source was dropped from configuration, or has never been reachable.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "gtfs.static.feeds.configured{application=~\"$application\"}",
          "legendFormat": "configured",
          "refId": "A"
        },
        {
          "expr": "count(gtfs.static.last.success.age.seconds{application=~\"$application\"})",
          "legendFormat": "reporting",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Sink / Store",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 46
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Database write rate",
      "description": "Database writes completed per second, broken down by operation.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (op) (rate(gtfs.sink.db.write_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 47
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Database write latency (average)",
      "description": "95% of database writes finish within this time; the remaining 5% take longer.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (op) (rate(gtfs.sink.db.write_sum{application=~\"$application\"}[$__rate_interval])) / sum by (op) (rate(gtfs.sink.db.write_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Database write latency (recent maximum)",
      "description": "Longest database write observed in the recent rolling window, approximately two minutes. This is not the maximum since startup.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "max by (op) (gtfs.sink.db.write.max{application=~\"$application\"})",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Flush duration (average and maximum)",
      "description": "Typical, slower, and slowest recent flush durations. p50 is the median, p95 covers 95% of flushes, and p99 covers 99%.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum(rate(gtfs.sink.flush.duration_sum{application=~\"$application\"}[$__rate_interval])) / sum(rate(gtfs.sink.flush.duration_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "average",
          "refId": "A"
        },
        {
          "expr": "max(gtfs.sink.flush.duration.max{application=~\"$application\"})",
          "legendFormat": "average",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 63
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Flushes per second",
      "description": "Number of buffer flushes completed per second.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (application) (rate(gtfs.sink.flush.duration_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 63
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Entities per flush",
      "description": "Average and recent maximum number of descriptors or stop-time updates processed in each flush. Values can be absent when no flushes occur; the maximum covers a rolling window of approximately two minutes.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(gtfs.sink.entities.count_sum{application=~\"$application\"}[$__rate_interval])) / sum by (type) (rate(gtfs.sink.entities.count_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "avg {{type}}",
          "refId": "A"
        },
        {
          "expr": "max by (type) (gtfs.sink.entities.count.max{application=~\"$application\"})",
          "legendFormat": "max {{type}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "spanNulls": true
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 71
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Entities processed per second",
      "description": "Descriptors and stop-time updates processed per second.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(gtfs.sink.entities.count_sum{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{type}} per second",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 71
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Duplicate updates dropped per second",
      "description": "Duplicate trip updates discarded per second before they are buffered.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (reason, instance) (rate(gtfs.sink.dropped{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{reason}} {{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 79
      }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Duplicate updates dropped",
      "description": "Total duplicate trip updates discarded during the selected time range.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "sum by (reason, instance) (increase(gtfs.sink.dropped{application=~\"$application\"}[$__range]))",
          "legendFormat": "{{reason}} {{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 79
      }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Average flush phase duration",
      "description": "Mean time each flush spends mapping the drained batch into rows and in each database write, broken down by phase. Mapping is client-side shaping; the db phases are the batch writes to the metadata, history, and hot tables.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "rate(gtfs.sink.map.duration_sum{application=~\"$application\"}[$__rate_interval]) / rate(gtfs.sink.map.duration_count{application=~\"$application\"}[$__rate_interval])",
          "legendFormat": "map",
          "refId": "A"
        },
        {
          "expr": "sum by (op) (rate(gtfs.sink.db.write_sum{application=~\"$application\"}[$__rate_interval])) / sum by (op) (rate(gtfs.sink.db.write_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "db {{op}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 87
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Off-heap store",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 95
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Off-heap store usage",
      "description": "Occupied and total off-heap store slots for each application instance.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "offheap.store.size{application=~\"$application\"}",
          "legendFormat": "size {{application}}",
          "refId": "A"
        },
        {
          "expr": "offheap.store.capacity{application=~\"$application\"}",
          "legendFormat": "capacity {{application}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 96
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Free off-heap slots",
      "description": "Unused off-heap store slots. A value near zero means the store is close to its current capacity and may need to grow.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "offheap.store.capacity{application=~\"$application\"} - offheap.store.size{application=~\"$application\"}",
          "legendFormat": "free {{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 96
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Off-heap store usage",
      "description": "Percentage of off-heap store capacity currently occupied. Automatic resizing starts at 70% usage.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "offheap.store.load.ratio{application=~\"$application\"}",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 104
      }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Current off-heap store usage",
      "description": "Current percentage of off-heap store capacity occupied by each application instance.",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "VictoriaMetrics"
      },
      "targets": [
        {
          "expr": "offheap.store.load.ratio{application=~\"$application\"}",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
