{
  "title": "GTFSynq Domain",
  "uid": "gtfsynq-domain",
  "tags": ["gtfsynq", "domain"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "editable": true,
  "refresh": "30s",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
        "query": {
          "query": "label_values(up{job=\"gtfsynq-apps\"}, instance)",
          "refId": "VictoriaMetrics"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "sort": 1,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Application availability",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "up{job=\"gtfsynq-apps\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Ingest",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Invalid feed entities skipped",
      "description": "Invalid feed entities skipped per second because they have no ID or entity type.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (instance) (rate(gtfs_ingest_skipped_invalid_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Invalid entities skipped",
      "description": "Total invalid feed entities skipped during the selected time range.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (instance) (increase(gtfs_ingest_skipped_invalid_total{instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 }
    },
    {
      "id": 21,
      "type": "row",
      "title": "Static feed",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 }
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Static feed age since last success",
      "description": "Seconds since the stalest configured feed was last ingested successfully. Static feeds poll on a days-scale cadence, so a growing value here is the stall signal no counter can give.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "max(gtfs_static_last_success_age_seconds{instance=~\"$instance\"})",
          "legendFormat": "stalest feed",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Age since last success by feed",
      "description": "Seconds since each feed was last ingested successfully. Alert when a feed exceeds roughly two poll intervals.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "gtfs_static_last_success_age_seconds{instance=~\"$instance\"}",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Static ingestion attempts by outcome",
      "description": "Attempts per second: success (new revision stored and published), unchanged (archive already stored) and failed.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(gtfs_static_ingest_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 }
    },
    {
      "id": 25,
      "type": "timeseries",
      "title": "Static feed download duration (95th percentile)",
      "description": "Time to stream a static archive off the remote server, 95th percentile. Useful for diagnosing the static-feed timeout.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gtfs_static_download_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 }
    },
    {
      "id": 26,
      "type": "stat",
      "title": "Static ingestion cycles skipped",
      "description": "Scheduled cycles skipped because the previous one was still running. Non-zero means ingestion is falling behind its own schedule.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum(increase(gtfs_static_cycle_skipped_total{instance=~\"$instance\"}[$__range]))",
          "legendFormat": "skipped",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 }
    },
    {
      "id": 27,
      "type": "timeseries",
      "title": "Static archive size (max)",
      "description": "Largest archive downloaded per feed in the current window. A sudden drop can mean a truncated or partial download.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "max by (feed) (gtfs_static_archive_size_bytes_max{instance=~\"$instance\"})",
          "legendFormat": "{{feed}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 30 }
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "Static feed cycle duration (95th percentile)",
      "description": "Wall clock time for one scheduled cycle, 95th percentile. Rising toward the 24h poll interval is the early warning that cycle.skipped will start incrementing.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gtfs_static_cycle_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 }
    },
    {
      "id": 29,
      "type": "timeseries",
      "title": "Feeds configured vs reporting",
      "description": "Sources with a usable static URL against feeds that have actually reported an attempt. A persistent gap means a source was dropped from configuration, or has never been reachable.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "gtfs_static_feeds_configured{instance=~\"$instance\"}",
          "legendFormat": "configured",
          "refId": "A"
        },
        {
          "expr": "count(gtfs_static_last_success_age_seconds{instance=~\"$instance\"})",
          "legendFormat": "reporting",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Sink / Store",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Database write rate",
      "description": "Database writes completed per second, broken down by operation.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (op) (rate(gtfs_sink_db_write_seconds_count{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 47 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Database write latency (95th percentile)",
      "description": "95% of database writes finish within this time; the remaining 5% take longer.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (op, le) (rate(gtfs_sink_db_write_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 47 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database write latency (99th percentile)",
      "description": "99% of database writes finish within this time; the slowest 1% take longer.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (op, le) (rate(gtfs_sink_db_write_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 55 }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Database write latency (recent maximum)",
      "description": "Longest database write observed in the recent rolling window, approximately two minutes. This is not the maximum since startup.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "max by (op) (gtfs_sink_db_write_seconds_max{instance=~\"$instance\"})",
          "legendFormat": "{{op}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 55 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Flush duration percentiles",
      "description": "Typical, slower, and slowest recent flush durations. p50 is the median, p95 covers 95% of flushes, and p99 covers 99%.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gtfs_sink_flush_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gtfs_sink_flush_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gtfs_sink_flush_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 63 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Flushes per second",
      "description": "Number of buffer flushes completed per second.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (instance) (rate(gtfs_sink_flush_duration_seconds_count{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 63 }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Entities per flush",
      "description": "Average and recent maximum number of descriptors or stop-time updates processed in each flush. Values can be absent when no flushes occur; the maximum covers a rolling window of approximately two minutes.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (type) (rate(gtfs_sink_entities_count_sum{instance=~\"$instance\"}[$__rate_interval])) / sum by (type) (rate(gtfs_sink_entities_count_count{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "avg {{type}}",
          "refId": "A"
        },
        {
          "expr": "max by (type) (gtfs_sink_entities_count_max{instance=~\"$instance\"})",
          "legendFormat": "max {{type}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "spanNulls": true }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 71 }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Entities processed per second",
      "description": "Descriptors and stop-time updates processed per second.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (type) (rate(gtfs_sink_entities_count_sum{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{type}} per second",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 71 }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Duplicate updates dropped per second",
      "description": "Duplicate trip updates discarded per second before they are buffered.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (reason, instance) (rate(gtfs_sink_dropped_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{reason}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 79 }
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Duplicate updates dropped",
      "description": "Total duplicate trip updates discarded during the selected time range.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum by (reason, instance) (increase(gtfs_sink_dropped_total{instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{reason}} {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 79 }
    },
    {
      "id": 30,
      "type": "timeseries",
      "title": "Average flush phase duration",
      "description": "Mean time each flush spends mapping the drained batch into rows and in each database write, broken down by phase. Mapping is client-side shaping; the db phases are the batch writes to the metadata, history, and hot tables.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "rate(gtfs_sink_map_duration_seconds_sum{instance=~\"$instance\"}[$__rate_interval]) / rate(gtfs_sink_map_duration_seconds_count{instance=~\"$instance\"}[$__rate_interval])",
          "legendFormat": "map",
          "refId": "A"
        },
        {
          "expr": "sum by (op) (rate(gtfs_sink_db_write_seconds_sum{instance=~\"$instance\"}[$__rate_interval])) / sum by (op) (rate(gtfs_sink_db_write_seconds_count{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "db {{op}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 87 }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Off-heap store",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 95 }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Off-heap store usage",
      "description": "Occupied and total off-heap store slots for each application instance.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "offheap_store_size{instance=~\"$instance\"}",
          "legendFormat": "size {{instance}}",
          "refId": "A"
        },
        {
          "expr": "offheap_store_capacity{instance=~\"$instance\"}",
          "legendFormat": "capacity {{instance}}",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 96 }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Free off-heap slots",
      "description": "Unused off-heap store slots. A value near zero means the store is close to its current capacity and may need to grow.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "offheap_store_capacity{instance=~\"$instance\"} - offheap_store_size{instance=~\"$instance\"}",
          "legendFormat": "free {{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 96 }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Off-heap store usage",
      "description": "Percentage of off-heap store capacity currently occupied. Automatic resizing starts at 70% usage.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "offheap_store_load_ratio{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "thresholdsStyle": { "mode": "dashed" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 104 }
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Current off-heap store usage",
      "description": "Current percentage of off-heap store capacity occupied by each application instance.",
      "datasource": { "type": "victoriametrics-metrics-datasource", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "offheap_store_load_ratio{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 104 }
    }
  ]
}
