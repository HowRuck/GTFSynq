{
  "title": "GTFSynq Postgres",
  "uid": "gtfsynq-postgres",
  "tags": ["gtfsynq", "postgres"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter up",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [{ "expr": "pg_up" }],
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Backends by database",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends",
          "legendFormat": "{{datname}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tuples fetched / returned",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_fetched[$__rate_interval])",
          "legendFormat": "fetched {{datname}}"
        },
        {
          "expr": "rate(pg_stat_database_tup_returned[$__rate_interval])",
          "legendFormat": "returned {{datname}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Commits / rollbacks",
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit[$__rate_interval])",
          "legendFormat": "commit {{datname}}"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback[$__rate_interval])",
          "legendFormat": "rollback {{datname}}"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    }
  ]
}
