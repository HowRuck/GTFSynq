{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "vaadin": {
        "type": "remote",
        "url": "https://mcp.vaadin.com/docs"
      },
      "vaadin-directory": {
        "type": "remote",
        "url": "https://vaadin.com/directory/mcp"
      },
      "gradle": {
        "type": "local",
        "command": ["jbang", "run", "--quiet", "--fresh", "gradle-mcp@rnett"]
      },
      "quarkus-agent": {
        "type": "local",
        "command": ["jbang", "quarkus-agent-mcp@quarkusio"]
      },
      "grafana": {
        "type": "local",
        "command": ["bash", "scripts/run-grafana-mcp.sh"]
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "@playwright/mcp@latest"]
      }
    }
  }
}
