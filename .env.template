# Copy this file to .env (gitignored) and replace every value below.
# Generate strong secrets, e.g.: openssl rand -base64 32
# The stack refuses to start until POSTGRES_PASSWORD and
# GF_SECURITY_ADMIN_PASSWORD are set (compose `:?` guard).

# --- TimescaleDB / application datasource ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD
POSTGRES_DB=gtfsynq

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD

# --- S3-compatible object storage for GTFS static feeds (http://localhost:9000) ---
S3_ACCESS_KEY=gtfsynq
S3_SECRET_KEY=CHANGE_ME_STRONG_UNIQUE_PASSWORD
S3_REGION=us-east-1
GTFSYNQ_STORAGE_S3_BUCKET=gtfsynq-static

# --- OpenTelemetry ---
# The apps export metrics, logs and traces to the collector in
# docker-compose.monitoring.yaml. If you run the application stack without that
# monitoring stack, set QUARKUS_OTEL_SDK_DISABLED=true so the apps stop trying
# to reach an absent otel-collector (which otherwise logs export failures).
QUARKUS_OTEL_SDK_DISABLED=false
# Only change this when the collector lives somewhere other than the Compose
# network, e.g. http://host.containers.internal:4317.
QUARKUS_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Host path to the container engine socket (Vector + podman exporter) ---
# Rootless Podman: /run/user/<uid>/podman/podman.sock
# Rootful Podman:  /run/podman/podman.sock
# Docker:          /var/run/docker.sock
PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# --- Used only when running the apps on the host (./gradlew quarkusDev) ---
# Quarkus maps these environment variables onto
# quarkus.datasource.* / kafka.bootstrap.servers / gtfsynq.storage.s3.*
QUARKUS_DATASOURCE_JDBC_URL=jdbc:postgresql://localhost:5432/gtfsynq
QUARKUS_DATASOURCE_USERNAME=postgres
QUARKUS_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GTFSYNQ_STORAGE_S3_ENDPOINT=http://localhost:9000
GTFSYNQ_STORAGE_S3_ACCESS_KEY=gtfsynq
GTFSYNQ_STORAGE_S3_SECRET_KEY=CHANGE_ME_STRONG_UNIQUE_PASSWORD
GTFSYNQ_STORAGE_S3_BUCKET=gtfsynq-static
