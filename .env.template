# Copy this file to .env (gitignored) and replace every value below.
# Generate strong secrets, e.g.: openssl rand -base64 32
# The stack refuses to start until POSTGRES_PASSWORD and
# GF_SECURITY_ADMIN_PASSWORD are set (compose `:?` guard).

# --- TimescaleDB / application datasource ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD
POSTGRES_DB=gtfsynq

# --- Grafana ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD

# --- pgAdmin (http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD

# --- Host path to the container engine socket (Vector + podman exporter) ---
# Rootless Podman: /run/user/<uid>/podman/podman.sock
# Rootful Podman:  /run/podman/podman.sock
# Docker:          /var/run/docker.sock
PODMAN_SOCKET=/run/user/1000/podman/podman.sock

# --- Used only when running the apps on the host (./gradlew bootRun) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/gtfsynq
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_UNIQUE_PASSWORD
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
