{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  ignorePaths: [
    '**/node_modules/**',
    '**/bower_components/**',
    '**/vendor/**',
    '**/examples/**',
    '**/__tests__/**',
    '**/test/**',
    '**/tests/**',
    '**/__fixtures__/**',
    '**/build/**',
    '**/target/**',
  ],
  schedule: [
    '* 0-5 * * *',
  ],
  semanticCommitType: 'build',
  semanticCommitScope: 'deps',
  commitMessageAction: 'bump',
  dependencyDashboard: {
    enabled: true,
  },
  dependencyDashboardApproval: false,
  prCreation: 'immediate',
  automerge: false,
  automergeType: 'pr',
  platformAutomerge: false,
  labels: [
    'dependencies',
  ],
  osvVulnerabilityAlerts: true,
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.java$/',
      ],
      matchStrings: [
        '@NpmPackage\\(\\s*value\\s*=\\s*"(?<depName>[^"]+)"\\s*,\\s*version\\s*=\\s*"(?<currentValue>[^"]+)"',
        '@NpmPackage\\(\\s*version\\s*=\\s*"(?<currentValue>[^"]+)"\\s*,\\s*value\\s*=\\s*"(?<depName>[^"]+)"',
      ],
      datasourceTemplate: 'npm',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'gradle',
      ],
      addLabels: [
        'java',
      ],
    },
    {
      matchManagers: [
        'gradle-wrapper',
      ],
      addLabels: [
        'gradle',
      ],
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      addLabels: [
        'docker',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      addLabels: [
        'github-actions',
      ],
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'modules/ui-app/src/main/java/**',
      ],
      addLabels: [
        'npm',
        'frontend',
      ],
    },
    {
      matchManagers: [
        'gradle',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'gradle-dependencies',
    },
    {
      matchManagers: [
        'gradle',
      ],
      matchPackageNames: [
        'io.quarkus*',
      ],
      addLabels: [
        'quarkus',
      ],
      groupName: 'quarkus',
    },
    {
      matchManagers: [
        'gradle',
      ],
      matchPackageNames: [
        'com.vaadin*',
      ],
      registryUrls: [
        'https://maven.vaadin.com/vaadin-prereleases',
        'https://repo1.maven.org/maven2',
      ],
      addLabels: [
        'vaadin',
        'frontend',
      ],
      groupName: 'vaadin',
    },
    {
      matchManagers: [
        'gradle-wrapper',
      ],
      enabled: true,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      groupName: 'github-actions',
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
        'pin',
      ],
      groupName: 'docker-images',
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        '/^ghcr\\.io\\/howruck\\/gtfsynq-/',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'docker-compose',
      ],
      matchPackageNames: [
        'docker.io/dpage/pgadmin4',
      ],
      allowedVersions: '/^\\d+(\\.\\d+)*$/',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchFileNames: [
        'modules/ui-app/**',
      ],
      enabled: false,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'modules/ui-app/src/main/java/**',
      ],
      postUpgradeTasks: {
        commands: [
          './gradlew :ui-app:quarkusBuild -x test --console=plain',
        ],
        fileFilters: [
          'modules/ui-app/package.json',
          'modules/ui-app/pnpm-workspace.yaml',
        ],
        executionMode: 'update',
      },
    },
    {
      matchManagers: [
        'gradle',
      ],
      matchPackageNames: [
        'com.vaadin*',
      ],
      postUpgradeTasks: {
        commands: [
          './gradlew :ui-app:quarkusBuild -x test --console=plain',
        ],
        fileFilters: [
          'modules/ui-app/package.json',
          'modules/ui-app/pnpm-workspace.yaml',
        ],
        executionMode: 'update',
      },
    },
    {
      matchManagers: [
        'gradle-wrapper',
      ],
      postUpgradeTasks: {
        commands: [
          './scripts/update-gradle-wrapper.sh',
        ],
        fileFilters: [
          'gradlew',
          'gradlew.bat',
          'gradle/wrapper/gradle-wrapper.jar',
          'gradle/wrapper/gradle-wrapper.properties',
        ],
        executionMode: 'update',
      },
    },
    {
      matchManagers: [
        'gradle',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
      ],
      automerge: true,
    },
    {
      matchManagers: [
        'gradle',
      ],
      matchPackageNames: [
        'io.quarkus*',
        'com.vaadin*',
      ],
      automerge: false,
    },
    {
      matchManagers: [
        'gradle-wrapper',
        'docker-compose',
        'github-actions',
        'custom.regex',
      ],
      automerge: false,
    },
  ],
}
